# MySQL 8 调优（PRD 6：库 zhiqiu，utf8mb4，量最大的 sensor_data 按月增）
# 被 docker-compose 挂到 /etc/mysql/conf.d/zhiqiu.cnf
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = '+08:00'

# 传感器数据写入频繁，innodb 缓冲给小机器也留足
innodb_buffer_pool_size = 256M
innodb_flush_log_at_trx_commit = 2
max_connections = 300
slow_query_log = 0

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
