# ===========================================================
# 「知秋」茶园多智能体平台 · 环境变量模板
# 用法：cp .env.example .env  然后填 LLM key（其余默认值可直接跑）
# 铁律：.env 永不进仓库，只提交本文件
# 注意：本文件里不要写行内注释 —— docker env_file 会把 # 之后的内容当成变量值
# ===========================================================

# ===== 时区 =====
TZ=Asia/Shanghai

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=zhiqiu_root_2026
MYSQL_DATABASE=zhiqiu
MYSQL_USER=zhiqiu
MYSQL_PASSWORD=zhiqiu_2026

# ===== Redis =====
REDIS_PASSWORD=zhiqiu_2026

# ===== Mosquitto =====
MQTT_USER=tea
MQTT_PASSWORD=tea_2026

# ===== LLM =====
# 取值：glm | deepseek
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 后端 =====
# 换成足够长的随机串（>=32 字符）
SECRET_KEY=CHANGE_ME_32chars_random_string_for_jwt_and_session
# 设置页 / 手动调试接口用的单管理员令牌
ADMIN_TOKEN=CHANGE_ME_admin_token

# ===== 服务地址 =====
# 默认值是 docker compose 内的服务名；本机直接跑 uvicorn 调试时全部改成 127.0.0.1
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Chroma 容器内监听 8000；宿主机映射到 8100（本机调试填 127.0.0.1 + 8100）
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ===== 运行开关 =====
LOG_LEVEL=INFO
# Mock 模拟器是否随后端一起启动（Mock 演示时保持 true）
SIMULATOR_AUTOSTART=true
# 以下都是**宿主机**端口映射；容器之间走服务名，不受影响
# 3307 是为了躲开本机已装的 MySQL（它常占 3306）
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
MQTT_HOST_PORT=1883
CHROMA_HOST_PORT=8100
BACKEND_PORT=8000
